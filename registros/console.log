name: techlab-oficinas
services:
  db:
    environment:
      POSTGRES_DB: techlab
      POSTGRES_PASSWORD: techlab
      POSTGRES_USER: techlab
    image: postgres:17-alpine
    networks:
      default: null
    volumes:
      - type: volume
        source: dados
        target: /var/lib/postgresql/data
        volume: {}
      - type: bind
        source: C:\Users\Alunos\Downloads\techlab\db\init.sql
        target: /docker-entrypoint-initdb.d/01-init.sql
        read_only: true
        bind: {}
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -h 127.0.0.1 -U $${POSTGRES_USER} -d $${POSTGRES_DB}
      timeout: 3s
      interval: 2s
      retries: 20
  web:
    environment:
      DATABASE_URL: postgres://techlab:techlab@db:5432/techlab
    networks:
      default: null
    build:
      context: C:\Users\Alunos\Downloads\techlab\web
      dockerfile: Dockerfile
    depends_on:
      db:
        condition: service_healthy
        required: true
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - fetch('http://127.0.0.1:3000/api/oficinas').then(r => {if (!r.ok) process.exit(1)}).catch(()
          => process.exit(1))
      timeout: 3s
      interval: 2s
      retries: 20
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        published: "8080"
        protocol: tcp
networks:
  default:
    name: techlab-oficinas_default
volumes:
  dados:
    name: techlab-oficinas_dados
